NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bootstrap "root" admin password. Sign in at /admin/login with an empty
# email + this password to reach the Admins page and seed real accounts.
ADMIN_PASSWORD=change-me

# Optional. Signs the admin session cookie. If unset, ADMIN_PASSWORD is used.
# Set to a long random string in production so rotating ADMIN_PASSWORD does
# not invalidate every session.
ADMIN_SESSION_SECRET=
