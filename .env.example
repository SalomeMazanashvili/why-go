NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Bootstrap "root" admin password. Sign in at /admin/login with an empty
# email + this password to reach the Admins page and seed real accounts.
ADMIN_PASSWORD=change-me

# Optional. Signs the admin session cookie. If unset, ADMIN_PASSWORD is used.
# Set to a long random string in production so rotating ADMIN_PASSWORD does
# not invalidate every session.
ADMIN_SESSION_SECRET=

# WHY-66: comma-separated recipients for inquiry notification emails.
# Both founders should be listed. Leave empty in dev to skip dispatch.
# Example: FOUNDER_EMAILS=nino@whygo.ge,giorgi@whygo.ge
FOUNDER_EMAILS=

# WHY-66: Resend + email sender. RESEND_API_KEY is required for real email
# dispatch; CONTACT_NOTIFICATION_FROM is the "From" address that must be
# verified in Resend. Leave RESEND_API_KEY empty in dev to no-op the emails
# (the API still records the inquiry and returns success).
RESEND_API_KEY=
CONTACT_NOTIFICATION_FROM=

# WHY-66: Cloudflare Turnstile keys. Public site key ships to the client;
# secret key server-side only. Leave both empty in dev to skip verification
# (the widget still renders but the server accepts any/no token). Set both
# in production so the inquiry endpoint enforces the challenge.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
